        "lines": [
          {
            "speaker": "रीना",
            "text": "अमन, ये घोंसला देखो... कितना टूटा हुआ है। लगता है कल रात की आँधी में पेड़ से गिर गया।",
            "emotion": "चिंतित"
          },
          {
            "speaker": "अमन",
            "text": "हाँ, बेचारे पंछी... अंदर तो कुछ पर भी नहीं बचे। चलो, इसे सँभाल कर रख देते हैं, शायद फिर से इस्तेमाल कर सकें।",
            "emotion": "दुखी",
            "action": "घोंसले को ध्यान से उठाते हुए"
          },
          {
            "speaker": "रीना",
            "text": "हाँ, यहीं पास में एक सूखी जगह है, वहाँ रख देते हैं। बारिश से बचा रहेगा।",
            "emotion": "आशावान",
            "action": "एक सुरक्षित जगह की ओर इशारा करते हुए"
          },
          {
            "speaker": "अमन",
            "text": "ठीक है, धीरे से रख... ऐसे ही। अब चलें, खेत का काम भी तो बाकी है।",
            "emotion": "शांत",
            "action": "घोंसला रखते हुए"
          }
        ]
      }
    ]
  },
