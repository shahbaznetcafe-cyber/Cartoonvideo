        "lines": [
          {
            "speaker": "Bilal",
            "text": "Behen, room mein itna andhera kyun hai? Mujhe kuch dikhayi nahi de raha.",
            "emotion": "scared",
            "action": "shivering"
          },
          {
            "speaker": "Sana",
            "text": "Bhai, dar mat. Mein hoon na. Bas light on kar deti hoon.",
            "emotion": "comforting",
            "action": "reaching for switch"
          },
          {
            "speaker": "Bilal",
            "text": "Par andhera bohot bara lagta hai. Jaise koi cheez ho.",
            "emotion": "anxious",
            "action": "clutching blanket"
          },
          {
            "speaker": "Sana",
            "text": "Nahi bhai, kuch nahi hai. Dekh, light on hai ab. Sab theek hai.",
            "emotion": "reassuring",
            "action": "sitting beside him"
          },
          {
            "speaker": "Bilal",
            "text": "Shukriya. Tum ho na, toh mujhe ajeeb sa sukoon milta hai.",
            "emotion": "relieved",
            "action": "smiling weakly"
          },
          {
            "speaker": "Sana",
            "text": "Hamesha rahungi. Ab so ja, subah school bhi jana hai.",
            "emotion": "loving",
            "action": "patting his head"
          }
        ]
      }
    ]
  },
