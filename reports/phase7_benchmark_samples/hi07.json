  "output": {
    "language": "hindi",
    "scenes": [
      {
        "id": "market_scene",
        "lines": [
          {
            "speaker": "बड़ी बहन",
            "text": "अरे, ये देखो! किसी का बटुआ गिरा है।",
            "emotion": "आश्चर्य",
            "action": "ज़मीन से बटुआ उठाती है"
          },
          {
            "speaker": "छोटी बहन",
            "text": "सच में? इसमें तो बहुत सारे पैसे हैं।",
            "emotion": "उत्सुकता",
            "action": "बटुए को ध्यान से देखती है"
          },
          {
            "speaker": "बड़ी बहन",
            "text": "हाँ, पर ये हमारा नहीं है। हमें इसका मालिक ढूँढना चाहिए।",
            "emotion": "निश्चय"
          },
          {
            "speaker": "छोटी बहन",
            "text": "सही कह रही हो। चलो, पूछते हैं आस-पास।",
            "emotion": "सहमति",
            "action": "इधर-उधर देखती है"
          },
          {
            "speaker": "बड़ी बहन",
            "text": "वो देखो, वो अंकल परेशान लग रहे हैं। शायद इनका ही हो।",
            "emotion": "आशा",
            "action": "एक व्यक्ति की ओर इशारा करती है"
          },
          {
            "speaker": "छोटी बहन",
            "text": "एक्सक्यूज़ मी, अंकल! क्या ये बटुआ आपका है?",
            "emotion": "विनम्रता",
            "action": "बटुआ दिखाती है"
          },
          {
            "speaker": "अंकल",
            "text": "हाँ बेटा, ये तो मेरा ही है! मैं कब से ढूँढ रहा था। बहुत-बहुत शुक्रिया!",
            "emotion": "राहत और खुशी"
          },
          {
            "speaker": "बड़ी बहन",
            "text": "कोई बात नहीं, अंकल। अगली बार ध्यान रखिएगा।",
            "emotion": "विनम्रता"
          },
          {
            "speaker": "छोटी बहन",
            "text": "चलो, अच्छा लगा मदद करके।",
            "emotion": "खुशी",
            "action": "बहन की ओर मुस्कुराती है"
          }
        ]
      }
    ]
  },
