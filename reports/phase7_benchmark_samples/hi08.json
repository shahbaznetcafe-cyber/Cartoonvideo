    "scenes": [
      {
        "id": "scene_1",
        "lines": [
          {
            "speaker": "बच्चा",
            "text": "दीदी, कमरा बहुत अँधेरा लग रहा है। मुझे डर लग रहा है।",
            "emotion": "डरा हुआ",
            "action": "कंबल कसकर पकड़ता है"
          },
          {
            "speaker": "बहन",
            "text": "अरे, मैं हूँ न। कुछ नहीं होगा। मैं लाइट थोड़ी धीमी कर देती हूँ, ठीक है?",
            "emotion": "स्नेहपूर्ण",
            "action": "धीरे से लाइट कम करती है"
          },
          {
            "speaker": "बच्चा",
            "text": "पर अगर अँधेरे में कुछ आ गया तो?",
            "emotion": "घबराया हुआ",
            "action": "आस-पास देखता है"
          },
          {
            "speaker": "बहन",
            "text": "देखो, यह सिर्फ कमरा है। खिड़की से चाँदनी आ रही है, और मैं तुम्हारे पास ही बैठी हूँ।",
            "emotion": "आश्वस्त करने वाली",
            "action": "बच्चे के बगल में बैठती है"
          },
          {
            "speaker": "बच्चा",
            "text": "तुम सच में यहीं रहोगी?",
            "emotion": "उम्मीद भरा",
            "action": "धीरे से बहन की ओर देखता है"
          },
          {
            "speaker": "बहन",
            "text": "हाँ, जब तक तुम सो नहीं जाते। चलो, एक गहरी साँस लो। साथ में।",
            "emotion": "शांत",
            "action": "धीरे-धीरे साँस लेती है"
          },
          {
            "speaker": "बच्चा",
            "text": "ठीक है... अब थोड़ा अच्छा लग रहा है।",
            "emotion": "आराम महसूस करता हुआ",
            "action": "कंधे ढीले करता है"
          },
          {
            "speaker": "बहन",
            "text": "बस ऐसे ही। अब आँखें बंद करो, और मैं तुम्हें एक छोटी सी कहानी सुनाती हूँ।",
            "emotion": "प्यार भरा",
            "action": "मुस्कुराती है"
          }
        ]
      }
    ]
  },
