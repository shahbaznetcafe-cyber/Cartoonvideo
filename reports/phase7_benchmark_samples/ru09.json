            "speaker": "Hina",
            "text": "Umar, idhar dekho! Is parinday ke par toot gaye hain aur khoon beh raha hai. Lagta hai kisi ne mara hai.",
            "emotion": "worried",
            "action": "pointing at the injured bird on the ground"
          },
          {
            "speaker": "Umar",
            "text": "Oh no, yeh to bura haal hai. Ruko, main abhi paani aur kapda laata hoon. Isko bachana hoga.",
            "emotion": "concerned",
            "action": "hurrying towards the farm shed"
          },
          {
            "speaker": "Hina",
            "text": "Jaldi karo, Umar! Iska saans ruk raha hai. Main isko pakadti hoon, lekin dheere se.",
            "emotion": "anxious",
            "action": "kneeling down carefully near the bird"
          },
          {
            "speaker": "Umar",
            "text": "Lo, main aa gaya. Paani do isko pehle, phir hum patti bandhte hain. Shukar hai tum ne dekh liya warna yeh mar jaata.",
            "emotion": "determined",
            "action": "handing a bowl of water to Hina"
          }
        ]
      }
