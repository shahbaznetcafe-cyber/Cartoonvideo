        "lines": [
          {
            "speaker": "ثنا",
            "text": "علی! وہ دیکھو، وہ صندوق ہل رہا ہے۔ مجھے بہت ڈر لگ رہا ہے۔",
            "emotion": "خوفزدہ",
            "action": "علی کی بانہہ پکڑتی ہے"
          },
          {
            "speaker": "علی",
            "text": "گھبراؤ نہیں، ثنا۔ میں دیکھتا ہوں اس میں کیا ہے۔",
            "emotion": "پرسکون",
            "action": "آہستہ سے صندوق کے قریب جاتا ہے"
          },
          {
            "speaker": "ثنا",
            "text": "نہیں، مت جاؤ! کچھ بھی ہو سکتا ہے اس میں۔",
            "emotion": "پریشان"
          },
          {
            "speaker": "علی",
            "text": "حوصلہ رکھو۔ میں نے ڈھکن کھول لیا ہے۔ ارے! یہ تو بس ایک پرانا کپڑا ہے جو ہوا سے ہل رہا تھا۔",
            "emotion": "مسکراہٹ",
            "action": "صندوق کا ڈھکن کھولتا ہے"
          },
          {
            "speaker": "ثنا",
            "text": "اوہ، شکر ہے! میں تو بے وجہ ڈر گئی تھی۔",
            "emotion": "راحت"
          }
        ]
      }
    ]
