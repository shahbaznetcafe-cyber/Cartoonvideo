    "scenes": [
      {
        "id": "scene_1",
        "lines": [
          {
            "speaker": "आरव",
            "text": "अरे, वहाँ झाड़ियों के पीछे कुछ हिल रहा है।",
            "emotion": "चौंकना",
            "action": "वह धीरे-धीरे आगे बढ़ता है"
          },
          {
            "speaker": "सिया",
            "text": "रुको, आरव। बिना देखे मत जाओ। हो सकता है अंदर कोई खतरा हो।",
            "emotion": "चिंतित",
            "action": "वह उसका हाथ पकड़कर रोकती है"
          },
          {
            "speaker": "आरव",
            "text": "तुम ठीक कह रही हो। ये तो एक संदूक लग रहा है... और ये सच में हिल रहा है।",
            "emotion": "सतर्क",
            "action": "वह संदूक पर नज़र टिकाए रखता है"
          },
          {
            "speaker": "सिया",
            "text": "दूर रहो। पहले हम दोनों मिलकर देखें, फिर ही उसे छुएँगे।",
            "emotion": "सावधान",
            "action": "वह चारों तरफ़ नज़र घुमाती है"
          },
          {
            "speaker": "आरव",
            "text": "ठीक है, मैं पीछे हटता हूँ। ज़रा ध्यान से खोलते हैं।",
            "emotion": "मामूली राहत",
            "action": "वह एक कदम पीछे हट जाता है"
          }
        ]
      }
    ]
  },
