        "lines": [
          {
            "speaker": "अनाया",
            "text": "देखो, दोस्त, कचरा हमेशा कचरा डिब्बे में ही डालना चाहिए।",
            "emotion": "समझाने वाला",
            "action": "कचरा डिब्बे की ओर इशारा करती है"
          },
          {
            "speaker": "दोस्त",
            "text": "क्यों? ज़मीन पर डाल देने से क्या फर्क पड़ता है?",
            "emotion": "जिज्ञासु",
            "action": "थोड़ा सोचते हुए पूछता है"
          },
          {
            "speaker": "अनाया",
            "text": "फर्क पड़ता है। अगर हम कचरा इधर-उधर फेंकेंगे, तो पार्क गंदा होगा, बदबू आएगी, और जानवरों को भी नुकसान हो सकता है।",
            "emotion": "गंभीर",
            "action": "धीरे-धीरे समझाती है"
          },
          {
            "speaker": "दोस्त",
            "text": "अच्छा, तो साफ़-सफ़ाई सबकी ज़िम्मेदारी है।",
            "emotion": "समझदार",
            "action": "सिर हिलाता है"
          },
          {
            "speaker": "अनाया",
            "text": "बिल्कुल। छोटा-सा सही काम मिलकर बड़ा बदलाव लाता है।",
            "emotion": "प्रोत्साहित",
            "action": "मुस्कुराती है"
          }
        ]
      }
    ]
  },
