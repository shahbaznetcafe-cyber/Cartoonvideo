        "lines": [
          {
            "speaker": "Hamza",
            "text": "Arre yaar, mera lunch box ghar reh gaya!",
            "emotion": "frustrated",
            "action": "apna bag khol kar dekhta hai"
          },
          {
            "speaker": "Mehak",
            "text": "Kya? Poora lunch bhool gaya?",
            "emotion": "surprised",
            "action": "uski taraf dekh kar thoda muskuraati hai"
          },
          {
            "speaker": "Hamza",
            "text": "Haan, aaj subah jaldi mein tha na.",
            "emotion": "embarrassed",
            "action": "kandhe uchkata hai"
          },
          {
            "speaker": "Mehak",
            "text": "Koi baat nahi, mere saath kha lo. Mera lunch zyada hai.",
            "emotion": "kind",
            "action": "apna tiffin aage badhaati hai"
          },
          {
            "speaker": "Hamza",
            "text": "Sach mein? Lekin tumhare liye toh...",
            "emotion": "hesitant",
            "action": "thoda jhijhakta hai"
          },
          {
            "speaker": "Mehak",
            "text": "Chal yaar, bhooka mat reh. Main bhi kha loongi, tu bhi.",
            "emotion": "insistent",
            "action": "tiffin khol kar roti nikaalti hai"
          },
          {
            "speaker": "Hamza",
            "text": "Shukriya Mehak, tu sach mein achi dost hai.",
            "emotion": "grateful",
            "action": "rot lete hue aankhon mein shukraguzari dikhaata hai"
          },
          {
            "speaker": "Mehak",
            "text": "Bas ab khaana shuru kar, warna time khatam ho jayega!",
            "emotion": "playful",
            "action": "haath se signal karti hai"
          }
        ]
      }
    ]
