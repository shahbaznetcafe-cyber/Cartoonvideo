        "lines": [
          {
            "speaker": "रोहन",
            "text": "माँ, जल्दी आओ! बाहर बारिश में एक छोटा पिल्ला काँप रहा है।",
            "emotion": "चिंतित",
            "action": "दरवाज़े पर खड़ा होकर माँ को पुकारता है"
          },
          {
            "speaker": "माँ",
            "text": "अरे, इतनी बारिश में? कहाँ है वो?",
            "emotion": "हैरान",
            "action": "जल्दी से आती हैं"
          },
          {
            "speaker": "रोहन",
            "text": "वो पेड़ के नीचे छुपा है। प्लीज़ माँ, हमें उसे अंदर लाना होगा, वरना बीमार पड़ जाएगा।",
            "emotion": "विनती करते हुए",
            "action": "माँ की ओर उम्मीद से देखता है"
          },
          {
            "speaker": "माँ",
            "text": "हाँ बेटा, तू ठीक कह रहा है। जा, मैं एक पुराना कपड़ा लाती हूँ ताकि उसे पोंछ सकें।",
            "emotion": "सहमत",
            "action": "कपड़ा लेने जाती हैं"
          }
        ]
      }
    ]
  },
